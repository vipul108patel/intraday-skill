# Angel One SmartAPI credentials
# Get API key: https://smartapi.angelone.in/
# Enable TOTP: https://smartapi.angelone.in/enable-totp
#
# NEVER commit the real .env file. Copy this to .env and fill values.

ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_mpin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Optional: pin session tokens after login (auto-filled by the app if empty)
# ANGEL_JWT_TOKEN=
# ANGEL_FEED_TOKEN=
# ANGEL_REFRESH_TOKEN=
